{
  "name": "toeslagbuddy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ToeslagBuddy – bereken al je toeslagen in één keer",
  "scripts": {
    "build": "node build.js",
    "test": "node --test test/*.test.js test/db/*.test.js",
    "serve": "node serve.js",
    "dev": "node build.js && node serve.js",
    "deploy": "bash scripts/deploy.sh",
    "social": "node social/render.js",
    "post": "node social/post.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.js",
    "check": "node build.js && node --test test/*.test.js test/db/*.test.js && node --test --test-concurrency=1 test/e2e/*.e2e.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "axe-core": "^4.13.0",
    "playwright": "^1.56.1"
  }
}
